# Only needed if the frontend and backend are NOT served from the same
# origin in production (e.g. frontend on Vercel, backend on Render).
# In local dev this is unnecessary — vite.config.ts already proxies
# /api requests to http://localhost:5000.
VITE_API_URL=https://your-backend-domain.com/api
VITE_SOCKET_URL=https://your-backend-domain.com
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
