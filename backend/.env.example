# LifeLink Backend — Environment Variables
# Copy this to .env and fill in your values.
#
# REQUIRED = the server refuses to start without these (see src/config/env.js)
# OPTIONAL = the related feature falls back to a mock/no-op without it —
#            nothing crashes, that feature just isn't "real" yet.

# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Must be the exact origin of your deployed frontend (no trailing slash).
# Also controls the refresh-token cookie's secure/sameSite behavior — see
# src/services/tokenService.js refreshCookieOptions(). Was documented as
# :3000 here previously, which doesn't match this project's actual dev
# frontend port (Vite defaults to 5173) — fixed.
CLIENT_URL=http://localhost:5173

# ── PostgreSQL Database — REQUIRED ──────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifelink
DB_USER=postgres
DB_PASSWORD=your_password_here
# Set to true for any managed cloud Postgres (Neon, Supabase, RDS, etc.)
# — they require SSL and reject plain connections.
DB_SSL=false

# ── JWT — REQUIRED ───────────────────────────────────────
# Generate a real random value, at least 32 characters — the server
# refuses to start with anything shorter. Never reuse the example value.
# Generate one with: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRE=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Email (Nodemailer / Gmail SMTP) — OPTIONAL ──────────
# Without this, emails are logged to the console instead of sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ── Twilio SMS — OPTIONAL ────────────────────────────────
# Without this, SMS sends are logged to the console instead of sent.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE=+1234567890

# ── Cloudinary — OPTIONAL ────────────────────────────────
# File uploads (medical reports/documents). Without this, uploads are
# accepted but return a mock URL instead of actually storing the file —
# was missing from this file entirely even though src/config/env.js and
# src/services/uploadService.js both read it; added.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Anthropic API — OPTIONAL ─────────────────────────────
# AI match explanations + triage assistant. Without this, both fall back
# to a clearly-labeled mock response — same pattern as email/SMS/upload.
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Google reCAPTCHA v2 — OPTIONAL ───────────────────────
# Registration bot protection. Without this, registration proceeds
# without CAPTCHA verification.
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
